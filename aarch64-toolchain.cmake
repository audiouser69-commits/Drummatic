# Cross-compilazione per Raspberry Pi 5 (Raspberry Pi OS 64 bit)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(DRUMMATIC_SYSROOT $ENV{DRUMMATIC_SYSROOT})
if (NOT DRUMMATIC_SYSROOT)
    set(DRUMMATIC_SYSROOT /home/claude/cross/sysroot)
endif()
set(ENV{PKG_CONFIG_LIBDIR} "${DRUMMATIC_SYSROOT}/usr/lib/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${DRUMMATIC_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a76")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a76 -isystem ${DRUMMATIC_SYSROOT}/usr/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${DRUMMATIC_SYSROOT}/usr/lib -static-libstdc++ -static-libgcc -Wl,-rpath-link,${DRUMMATIC_SYSROOT}/usr/lib")
set(CMAKE_FIND_ROOT_PATH ${DRUMMATIC_SYSROOT} /usr/aarch64-linux-gnu)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
